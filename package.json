{
  "name": "master-key-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/create-offline-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check:content": "node scripts/check-content.mjs",
    "test": "npm run check:content && npm run test:backup && npm run test:concepts",
    "test:browser": "playwright test",
    "preview:pages": "node scripts/serve-pages-preview.mjs",
    "test:backup": "node --test tests/backup.test.mjs",
    "test:concepts": "node --test tests/concepts.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@playwright/test": "^1.56.0"
  }
}
